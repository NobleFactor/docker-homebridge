/HomebridgeBackups.rclone.log
/HomebridgeBackups/**
/volumes/**

/.github/copilot-instructions.md

# Exclude all certificate files from secrets directory
secrets/**/*.pem
secrets/**/*.csr
secrets/**/*.crt
secrets/**/*.key
secrets/certificates/*/
!secrets/certificates/*.template

# Exclude generated environment files
homebridge-*.yaml
homebridge-*.env

# Exclude rclone configuration
secrets/rclone.conf

# Exclude Makefile env stamp files (created at repo root)
.env-*.stamp
