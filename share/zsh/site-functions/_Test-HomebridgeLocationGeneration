_Test-HomebridgeLocationGeneration() {
    local -a opts locations

    # Find available test locations
    locations=(${${(f)"$(find test -maxdepth 1 -name 'homebridge-*.env' 2>/dev/null)"}:t:s/homebridge-//:s/.env//})

    opts=(
        '(-h --help)'{-h,--help}'[Show usage information and exit]'
        "--test-location[Location name to test]:location:(${locations[*]:-fake-wa})"
    )

    _arguments -s -S $opts
}

_Test-HomebridgeLocationGeneration "$@"
